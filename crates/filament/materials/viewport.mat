// Viewport PBR material for SubstanceCraft. Compiled by build.rs with the matc
// from the vendored Filament build, so the package always matches the engine version.
//
// Material mode: Base Color (sRGB, Opacity in alpha), an ORM map (linear: R
// ambient occlusion, G roughness, B metallic), a tangent-space normal map
// (linear, +Y = +V), and an emissive map (sRGB). Opacity is alpha-tested, so
// cut-outs stay depth-sorted without blending artifacts.
// Preview mode: only the base colour map is shown, opaque, on a neutral
// dielectric, so single channels and mesh maps can be inspected without PBR
// interference.
material {
    name : SubstanceCraftViewport,
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.5,
    doubleSided : true,
    requires : [ uv0, tangents ],
    parameters : [
        {
            type : sampler2d,
            name : baseColorMap
        },
        {
            type : sampler2d,
            name : ormMap
        },
        {
            type : sampler2d,
            name : normalMap
        },
        {
            type : sampler2d,
            name : emissiveMap
        },
        {
            type : float,
            name : previewMode
        },
        {
            type : float,
            name : emissiveStrength
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        float2 uv = getUV0();
        bool preview = materialParams.previewMode > 0.5;
        if (!preview) {
            material.normal = texture(materialParams_normalMap, uv).xyz * 2.0 - 1.0;
        }
        prepareMaterial(material);
        // Rows are uploaded top to bottom, matching BakedTexture::sample_uv.
        material.baseColor = texture(materialParams_baseColorMap, uv);
        if (preview) {
            material.baseColor.a = 1.0;
            material.roughness = 0.58;
            material.metallic = 0.0;
        } else {
            float3 orm = texture(materialParams_ormMap, uv).rgb;
            material.ambientOcclusion = orm.r;
            material.roughness = orm.g;
            material.metallic = orm.b;
            float3 emitted = texture(materialParams_emissiveMap, uv).rgb;
            material.emissive = float4(emitted * materialParams.emissiveStrength, 0.0);
        }
    }
}
