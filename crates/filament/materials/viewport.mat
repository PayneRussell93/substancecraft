// Viewport PBR material for SubstanceCraft. Compiled by build.rs with the matc
// from the vendored Filament build, so the package always matches the engine version.
material {
    name : SubstanceCraftViewport,
    shadingModel : lit,
    doubleSided : true,
    requires : [ uv0 ],
    parameters : [
        {
            type : sampler2d,
            name : baseColorMap
        },
        {
            type : float,
            name : roughness
        },
        {
            type : float,
            name : metallic
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Base Color rows are uploaded top to bottom, matching MaterialTexture::sample_uv.
        material.baseColor = texture(materialParams_baseColorMap, getUV0());
        material.roughness = materialParams.roughness;
        material.metallic = materialParams.metallic;
    }
}
